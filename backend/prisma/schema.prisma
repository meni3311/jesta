generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  WORKER    // teenager looking for gigs
  EMPLOYER  // business / individual posting gigs
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  NO_SHOW   // employer marked the worker as a no-show
}

enum NotificationType {
  CONFIRM_SHIFT         // legacy name for PRE_SHIFT_REMINDER (old rows)
  CONFIRM_SHIFT_URGENT  // T-2h second, urgent reminder
  JOB_REOPENED          // legacy name for NO_SHOW_FALLBACK (old rows)
  RATE_REQUEST          // legacy name for RATING_REQUEST (old rows)
  DIRECT_OFFER          // Pro employer sent a personal job offer
  OFFER_RESPONSE        // worker accepted / declined a direct offer
  GENERAL
  NEW_APPLICANT         // employer: a teenager applied to your job
  APPLICATION_APPROVED  // teenager: the employer approved you
  PRE_SHIFT_REMINDER    // teenager: T-3h "please confirm arrival"
  SHIFT_CONFIRMED       // employer: the teenager confirmed arrival
  NO_SHOW_FALLBACK      // pending applicants: spot reopened after a no-show
  RATING_REQUEST        // both sides after a completed gesta
  EMERGENCY_GESTA       // nearby available teenagers: emergency job posted
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Coin ledger entry kind. The ledger is append-only; every balance change on
// a user has exactly one matching CoinTransaction row.
enum CoinTxnType {
  PURCHASE        // bought a coin package via Stripe
  JOB_CHARGE      // charged when a worker confirmed arrival (a slot was filled)
  REFERRAL_BONUS  // referral reward (to referrer and to the referred employer)
  ADJUSTMENT      // manual admin correction
  REFUND          // reversal of a previous charge
}

// Mirrors the subset of Stripe subscription statuses we act on.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
  UNPAID
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?
  passwordHash  String
  role          UserRole
  fullName      String
  avatarUrl     String?
  rating        Float    @default(0)   // rating_avg — average of received ratings
  ratingCount   Int      @default(0)   // how many ratings the average is based on
  completedJobs Int      @default(0)

  // ── Jesta Score (0-100 composite) ──
  // 40% avg rating · 30% attendance · 20% response speed · 10% completed count.
  // 60 = the neutral baseline for a brand-new user (see ScoreService).
  jestaScore       Float @default(60)
  showUpCount      Int   @default(0)  // confirmed-completed shifts
  noShowCount      Int   @default(0)  // employer-marked no-shows
  responseCount    Int   @default(0)  // samples in the response-speed average
  responseTotalMin Float @default(0)  // sum of minutes-to-confirm (avg = total/count)

  // ── Reliability / strikes ──
  warningFlag    Boolean   @default(false) // 1st no-show: visible warning
  suspendedUntil DateTime?                 // 2nd no-show: 48h suspension
  reviewFlag     Boolean   @default(false) // 3rd no-show: blocked pending manual review

  // ── Pro employer plan ──
  isPro       Boolean @default(false)
  proFeatures Json    @default("{}") // future flags, e.g. { "prioritySupport": true }

  // ── Coins wallet (employer side) ──
  // 1 coin = ₪1 of internal value (never surfaced to the employer as ₪).
  // Balance is mutated only by the backend (service-role) via CoinsService;
  // every change writes a matching CoinTransaction row.
  coinsBalance Int @default(0)

  // ── Pro subscription (Stripe) ──
  proExpiresAt         DateTime?            // next billing date while active; past = lapsed
  stripeCustomerId     String?             @unique // Stripe Customer, reused across payments
  stripeSubscriptionId String?                     // active Pro subscription, if any
  subscriptionStatus   SubscriptionStatus?

  // ── Referral program (employer → employer) ──
  // Each employer has a unique code. When a referred employer posts their
  // FIRST job, both sides receive 20 coins (paid once, idempotent).
  referralCode     String?  @unique
  referredById     String?                 // the employer who referred this one
  firstJobPostedAt DateTime?               // set on first job → triggers referral payout

  // ── Direct hiring (worker side) ──
  availability Json? // e.g. { "open": true, "days": ["א","ב"], "hours": "16:00-22:00", "note": "..." }

  isVerified               Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpiry  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  postedJobs      Job[]          @relation("EmployerJobs")
  applications    Application[]
  employerChats   Chat[]         @relation("EmployerChats")
  workerChats     Chat[]         @relation("WorkerChats")
  sentMessages    Message[]      @relation("SentMessages")
  ratingsGiven    Rating[]       @relation("RatingsGiven")
  ratingsReceived Rating[]       @relation("RatingsReceived")
  notifications   Notification[]
  offersSent      JobOffer[]     @relation("OffersSent")
  offersReceived  JobOffer[]     @relation("OffersReceived")
  availabilitySlots AvailabilitySlot[]

  // Coins & referrals
  coinTransactions CoinTransaction[]
  referredBy       User?       @relation("EmployerReferrals", fields: [referredById], references: [id])
  referredEmployers User[]     @relation("EmployerReferrals")
  referralsMade    Referral[]  @relation("ReferralReferrer")
  referralReceived Referral?   @relation("ReferralReferred")

  @@map("users")
}

// ── Availability profile (System 2) ─────────────────────────────────────────
// One row per selected weekly time block. minWage / categories /
// isOpenToOffers ride on every row; the API rewrites a user's rows atomically.
model AvailabilitySlot {
  id             String   @id @default(uuid())
  userId         String
  dayOfWeek      Int      // 0 = Sunday … 6 = Saturday
  startTime      String   // "HH:MM" zero-padded
  endTime        String   // "HH:MM"
  minWage        Float    @default(0)
  categories     String[] @default([])
  isOpenToOffers Boolean  @default(true)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, startTime])
  @@index([userId])
  @@map("availability")
}

model Job {
  id          String   @id @default(uuid())
  employerId  String
  title       String
  description String?
  pay         Float    // hourly rate (NIS)
  requiredWorkers Int  @default(1) // how many workers the employer needs

  // ── Multi-worker filling (Pro) ──
  // A job is "filled" only when filledSlots === requiredWorkers. Each filled
  // slot (a worker confirming arrival) charges the employer separately.
  filledSlots Int      @default(0)
  filledAt    DateTime?           // set when the LAST required slot is filled
  // Shared invite link token: workers opening it join the shift directly.
  inviteToken String?  @unique

  address     String
  lat         Float
  lng         Float
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(true)
  isInsured   Boolean  @default(false) // Pro: "ג'סטה מבוטחת" — auto-fallback + priority support on no-show

  // ── Emergency Gesta (ג'סטה חירום) ──
  // Starts within 3h; wage auto-raised by 20% (pay = basePay * 1.2);
  // pinned to the top of all feeds; nearby available workers are notified.
  isEmergency Boolean  @default(false)
  basePay     Float?   // original wage before the +20% emergency bonus

  category    String?   // job category id, e.g. 'delivery' | 'babysit' | 'events'
  cancelledAt DateTime? // employer cancelled the job

  perks       String[] // e.g. ["מזומן בסוף המשמרת", "אוכל כלול"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id])
  applications Application[]
  ratings      Rating[]
  offers       JobOffer[]

  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String
  workerId  String
  status    ApplicationStatus @default(PENDING)

  // true when the rejection was automatic (another applicant was approved) —
  // these applicants ARE re-invited by the no-show fallback flow; manually
  // rejected ones are not.
  autoRejected Boolean @default(false)

  // ── Coin charge (this application = one filled slot) ──
  // Set when arrival is confirmed and the employer is charged. coinCharged
  // makes the charge idempotent (a slot is never billed twice).
  coinCharged   Boolean   @default(false)
  coinChargedAt DateTime?
  coinAmount    Int?      // coins charged for this slot (18 Pro / 20 Free)

  // ── Reliability timestamps ──
  approvedAt         DateTime? // when the employer approved (basis for response-speed)
  confirmedAt        DateTime? // worker tapped "אישור הגעה"
  noShowAt           DateTime? // employer marked no-show
  completedAt        DateTime? // employer marked completed
  preShiftNotifiedAt DateTime? // T-3h confirmation prompt sent
  urgentNotifiedAt   DateTime? // T-2h urgent reminder sent

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  job     Job   @relation(fields: [jobId], references: [id])
  worker  User  @relation(fields: [workerId], references: [id])
  chat    Chat?

  @@unique([jobId, workerId])
  @@map("applications")
}

model Rating {
  id         String   @id @default(uuid())
  jobId      String
  fromUserId String
  toUserId   String
  score      Int      // 1-5 stars
  comment    String?  // optional, max 100 chars (validated in DTO)
  createdAt  DateTime @default(now())

  // Relations
  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromUser User @relation("RatingsGiven",    fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsReceived", fields: [toUserId],   references: [id])

  @@unique([jobId, fromUserId]) // one rating per rater per gesta
  @@index([toUserId])
  @@map("ratings")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String           // short Hebrew headline
  body          String?          // optional longer text
  jobId         String?          // loose references (no FK — survives job deletion)
  applicationId String?
  offerId       String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model JobOffer {
  id          String      @id @default(uuid())
  jobId       String
  employerId  String
  workerId    String
  status      OfferStatus @default(PENDING)
  message     String?     // optional personal note from the employer
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  // Relations
  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employer User @relation("OffersSent",     fields: [employerId], references: [id])
  worker   User @relation("OffersReceived", fields: [workerId],   references: [id])

  @@unique([jobId, workerId]) // one offer per worker per job
  @@index([workerId, status])
  @@map("job_offers")
}

model Chat {
  id            String   @id @default(uuid())
  applicationId String   @unique
  employerId    String
  workerId      String
  createdAt     DateTime @default(now())

  // Relations
  application Application @relation(fields: [applicationId], references: [id])
  employer    User        @relation("EmployerChats", fields: [employerId], references: [id])
  worker      User        @relation("WorkerChats",   fields: [workerId],   references: [id])
  messages    Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  // Relations
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

// ── Coin packages (purchasable bundles) ──────────────────────────────────────
// priceIls is stored in AGOROT (integer): 2500 = ₪25.00.
model CoinPackage {
  id           String   @id @default(uuid())
  name         String   // 'Starter' | 'Standard' | 'Pro Pack' | 'Business'
  coins        Int      // coins credited on purchase
  priceIls     Int      // price in agorot (2500 = ₪25)
  stripePriceId String? // optional pre-created Stripe Price (future use)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  transactions CoinTransaction[]

  @@map("coin_packages")
}

// ── Coin ledger (append-only) ────────────────────────────────────────────────
// One row per balance change. `amount` is signed: positive = credit,
// negative = debit. `balanceAfter` snapshots the wallet right after the change.
model CoinTransaction {
  id            String      @id @default(uuid())
  userId        String
  type          CoinTxnType
  amount        Int         // +credit / -debit, in coins
  balanceAfter  Int         // wallet balance immediately after applying `amount`
  jobId         String?     // set for JOB_CHARGE / REFUND
  applicationId String?     // the specific filled slot, for JOB_CHARGE
  packageId     String?     // set for PURCHASE
  stripePaymentIntentId String? // Stripe PI id — also the purchase idempotency key
  description   String?
  createdAt     DateTime    @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package CoinPackage? @relation(fields: [packageId], references: [id])

  // One ledger row per Stripe PaymentIntent → webhook is idempotent.
  @@unique([stripePaymentIntentId])
  @@index([userId, createdAt])
  @@map("coin_transactions")
}

// ── Referrals (employer → employer) ──────────────────────────────────────────
// Created when a referred employer signs up with a referrer's code. Paid out
// (20 coins to each side) exactly once, when the referred employer posts their
// first job.
model Referral {
  id          String    @id @default(uuid())
  referrerId  String    // employer who shared their code
  referredId  String    @unique // employer who used it (referred once only)
  bonusCoins  Int       @default(20)
  paidOut     Boolean   @default(false)
  paidOutAt   DateTime?
  createdAt   DateTime  @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}
